{
  "mcpServers": {
    "causeline-mcp": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/causeline-mcp.mjs"],
      "env": {
        "CAUSELINE_PACK": "${CAUSELINE_PACK:-}",
        "CAUSELINE_TOOLBOX": "${CAUSELINE_TOOLBOX:-}",
        "CAUSELINE_TOOLBOX_URL": "${CAUSELINE_TOOLBOX_URL:-}",
        "CAUSELINE_PLAYBOOKS": "${CLAUDE_PLUGIN_ROOT}/playbooks"
      }
    }
  }
}
